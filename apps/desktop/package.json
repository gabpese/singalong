{
  "name": "@singalong/desktop",
  "private": true,
  "version": "1.4.2",
  "productName": "Singalong Karaoke",
  "description": "Singalong Karaoke: a interface do computador do dono (pareia, monta o motor, inicia a sessão e o agente)",
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:engine": "node scripts/build-engine.mjs",
    "prestart": "npm run build:engine",
    "start": "electron .",
    "pretest": "npm run build:engine",
    "test": "node --test --test-timeout=60000 \"test/*.test.js\"",
    "pretest:e2e": "npm run build:engine",
    "test:e2e": "node --test \"e2e/*.e2e.js\"",
    "dist": "node scripts/build-installer.mjs",
    "dist:dir": "node scripts/build-installer.mjs --dir",
    "dist:win": "node scripts/build-installer.mjs --platform=win",
    "dist:mac": "node scripts/build-installer.mjs --platform=mac",
    "dist:linux": "node scripts/build-installer.mjs --platform=linux"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "playwright-core": "^1.50.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@singalong/engine": "file:../engine",
    "electron-updater": "^6.8.9"
  },
  "author": "Singalong",
  "desktopName": "singalong_karaoke.desktop",
  "build": {
    "appId": "org.singalong.karaoke",
    "productName": "Singalong Karaoke",
    "executableName": "singalong_karaoke",
    "copyright": "Singalong",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "ui/**",
      "package.json",
      "!**/*.map",
      "!node_modules/@singalong/engine/src/**",
      "!node_modules/@singalong/engine/tsconfig.json"
    ],
    "extraResources": [
      {
        "from": "../worker",
        "to": "worker",
        "filter": [
          "singalong_worker/**",
          "requirements.txt",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "singalong_karaoke.${ext}",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "singalong_karaoke-mac-arm64.${ext}",
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Singalong Karaoke",
      "artifactName": "singalong_karaoke-mac-arm64.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "singalong_karaoke-linux-x86_64.${ext}",
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Karaokê colaborativo: o seu computador prepara as músicas",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "singalong_karaoke-linux-x86_64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Singalong Karaoke",
      "artifactName": "singalong_karaoke.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": null
  }
}
