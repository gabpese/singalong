# Copie para /opt/singalong/.env na VM e ajuste.

# O endereço público, SEM https:// (o Caddy emite o certificado para ele).
# Exemplo com um subdomínio grátis do DuckDNS: singalong.duckdns.org
SITE_ADDRESS=singalong.duckdns.org

# Dono do repositório no GitHub (onde a imagem da API é publicada) e a versão a rodar.
GHCR_OWNER=gabpese
IMAGE_TAG=latest

LOG_LEVEL=info
