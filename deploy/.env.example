# Copy to /opt/singalong/.env on the VM and adjust.

# The public address, WITHOUT https:// (Caddy issues the certificate for it).
# An example with a free DuckDNS subdomain: singalong.duckdns.org
SITE_ADDRESS=singalong.duckdns.org

# The repository's owner on GitHub (where the API image is published) and the version to run.
GHCR_OWNER=gabpese
IMAGE_TAG=latest

LOG_LEVEL=info

# Local agent (optional): with a secret here, the server accepts pairing the app installed on the Owner's computer (/agent/v1).
# Leave it empty to turn it off. Generate a long random value (e.g. openssl rand -hex 24) and keep it to yourself.
ADMIN_TOKEN=

# Pairing code by e-mail (optional). The person types the e-mail in the app and the server sends the code, only to those on the list.
# Needs a free Brevo account (https://www.brevo.com): create an API key and verify the sender e-mail.
# Use an asterisk (PAIR_ALLOWED_EMAILS=*) to allow any e-mail (the request limits still apply); empty turns the feature off.
PAIR_ALLOWED_EMAILS=
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Singalong

# Hybrid mode: e-mails (comma-separated) whose computers send the songs they prepare to the server, automatically.
# Whoever is paired with one of these e-mails (through the code sent by e-mail) starts feeding the cloud's library.
ENABLED_TO_SEND_TO_CLOUD=

# The administrator's page: its SECRET address (https://YOUR_ADDRESS/<value>/). There is no fixed /admin. Generate it with: openssl rand -hex 16
# Without this value (16 to 64 letters, digits, _ or -) the page does not exist.
ADMIN_PATH=

# The installed app's update notice (people see "Atualizar agora"). Fill it in after publishing the Release.
APP_LATEST_VERSION=
APP_MIN_VERSION=
APP_NOTES=
APP_DOWNLOAD_URL=
