# Copie para /opt/singalong/.env na VM e ajuste.

# O endereço público, SEM https:// (o Caddy emite o certificado para ele).
# Exemplo com um subdomínio grátis do DuckDNS: singalong.duckdns.org
SITE_ADDRESS=singalong.duckdns.org

# Dono do repositório no GitHub (onde a imagem da API é publicada) e a versão a rodar.
GHCR_OWNER=gabpese
IMAGE_TAG=latest

LOG_LEVEL=info

# Agente local (opcional): com um segredo aqui, o servidor aceita parear o app instalado no computador do dono (/agent/v1).
# Deixe vazio para desligar. Gere um valor longo e aleatório (ex.: openssl rand -hex 24) e guarde só com você.
ADMIN_TOKEN=

# Codigo de pareamento por e-mail (opcional). A pessoa digita o e-mail no app e o servidor envia o codigo, so para quem esta na lista.
# Precisa de uma conta gratuita no Brevo (https://www.brevo.com): crie uma chave de API e verifique o e-mail remetente.
# Use um asterisco (PAIR_ALLOWED_EMAILS=*) para liberar qualquer e-mail (os limites de pedidos continuam); vazio desliga o recurso.
PAIR_ALLOWED_EMAILS=
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Singalong

# Modo híbrido: e-mails (separados por vírgula) cujos computadores enviam as músicas que preparam para o servidor, automaticamente.
# Quem for pareado com um destes e-mails (pelo código enviado por e-mail) passa a alimentar a biblioteca da nuvem.
ENABLED_TO_SEND_TO_CLOUD=
