# Caddy: automatic HTTPS (Let's Encrypt) in front of the API. SITE_ADDRESS comes from .env (e.g. mysingalong.duckdns.org).
# HTTPS is required: without it the TV's browser allows neither the key change (AudioWorklet) nor the scoring's microphone.
{$SITE_ADDRESS} {
	encode zstd gzip

	# the WebSocket (the TV and the Room's phones) goes through the same proxy, with no extra setup
	reverse_proxy api:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# the page must not be embedded in other sites; the YouTube preview is an iframe INSIDE it (not affected)
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}
